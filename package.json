{
  "name": "pi-capsule-tools",
  "version": "1.0.0",
  "type": "module",
  "description": "Render pi tool calls as one-line green capsules, expandable with ctrl+o",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "tui",
    "capsule",
    "tool-renderer"
  ],
  "pi": {
    "extensions": [
      "./capsule-tools.ts"
    ]
  },
  "files": [
    "capsule-tools.ts",
    "README.md"
  ],
  "scripts": {
    "check": "node --experimental-strip-types check.ts && node --experimental-strip-types rows-check.ts && node --experimental-strip-types resolve-check.ts && node --experimental-strip-types real-data-check.ts",
    "typecheck": "tsc --noEmit --skipLibCheck --module nodenext --moduleResolution nodenext --target es2022 --strict capsule-tools.ts",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "typescript": "^7.0.2"
  }
}
